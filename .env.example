# =============================================================================
# Finanstrack — backend
# Copia este archivo a `.env` en la raíz del proyecto (junto a este archivo).
# En Render pega LAS MISMAS variables en Environment. No subas el .env a git.
#
# Dónde se consigue cada cosa:
#   Supabase  →  https://supabase.com/dashboard  → tu proyecto
#   Render    →  https://dashboard.render.com    → el servicio web → Environment
#   Vercel    →  el front, NO este archivo. Ver front/.env.example
# =============================================================================

# development | production | test
# En Render déjalo en production (render.yaml ya lo pone).
ENVIRONMENT=development

# true muestra el SQL en la consola y abre /docs. En Render va en false.
DEBUG=true

# --- Base de datos (Supabase Postgres) ----------------------------------------
# Supabase → Project Settings → Database → Connection string → URI
# Elige "Session pooler" (puerto 5432), NO el "Transaction pooler" (6543):
# Alembic y SQLAlchemy necesitan una sesión de verdad.
#
# Supabase te copia algo así:
#   postgresql://postgres.ABCDEF:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Cámbialo a postgresql+psycopg2:// y agrega ?sslmode=require si no viene.
#
# La contraseña es la de la base (Database password), no la de tu cuenta Supabase.
# Si la perdiste: Database → Reset database password.
DATABASE_URL=postgresql+psycopg2://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Referencia. La API no se conecta con estas llaves: usa DATABASE_URL.
# Sirven para saber qué copiar del panel y para un cliente de Supabase más adelante.
# Supabase → Project Settings → API
#   Project URL          → SUPABASE_URL
#   anon public          → SUPABASE_ANON_KEY
# La llave service_role NO va aquí y NUNCA va al front: salta las reglas de acceso.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=

# --- Sesión -------------------------------------------------------------------
# Genera una clave larga y distinta en cada entorno (local y Render no tienen
# que coincidir). En PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_ALGORITHM=HS256
# Minutos que dura el access token. El front lo renueva con el refresh.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Días que dura el refresh token. 30 cubre un ciclo de pago mensual.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Front (Vercel) -----------------------------------------------------------
# Orígenes permitidos, separados por coma, SIN barra al final.
# Local: el Vite de abajo. Producción: la URL que te da Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Los previews de Vercel (ramas) cambian de subdominio. Este regex los deja
# pasar. Si quieres cerrarlo a un solo dominio, déjalo vacío en Render.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# La URL pública del front. Hoy se guarda para armar enlaces; el login no
# manda correos.
FRONTEND_URL=http://localhost:5173

# "Hoy" para el usuario. El servidor puede estar en UTC (Render lo está).
ZONA_HORARIA=America/Bogota

# --- Google (iniciar y crear cuenta) -----------------------------------------
# No es una "API key". Es el ID de cliente de OAuth.
#   1. https://console.cloud.google.com/apis/credentials
#   2. Configura la pantalla de consentimiento (Externa, nombre Finanstrack).
#   3. Credenciales → Crear credenciales → ID de cliente de OAuth → Aplicación web.
#   4. Orígenes de JavaScript autorizados (sin barra al final):
#        http://localhost:5173
#        http://127.0.0.1:5173
#        https://TU-PROYECTO.vercel.app
#   5. URI de redireccionamiento: el botón no lo usa. Si la consola te obliga,
#      repite esas mismas tres URLs.
#   6. Copia el Client ID aquí y, el MISMO valor, en front/.env como
#      VITE_GOOGLE_CLIENT_ID (y en Vercel, con ese nombre).
# El Client secret que muestra Google NO va aquí ni en el front.
# Vacío: la API arranca, y el botón avisa que falta esto.
GOOGLE_CLIENT_ID=
